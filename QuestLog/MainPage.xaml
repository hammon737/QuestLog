<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local ="clr-namespace:QuestLog"
             x:Class="QuestLog.MainPage"
             Title="Quest Log">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          Padding="24"
          RowSpacing="14">

        <Label Grid.Row="0"
               Text="Quest Log"
               FontSize="30"
               FontAttributes="Bold" />

        <Label Grid.Row="1"
               x:Name="CountLabel"
               Text="0 quests"
               FontSize="14"
               TextColor="Gray" />

        <Border Grid.Row="2" Stroke="LightGray" StrokeThickness="1" Padding="4">
            
            <CollectionView x:Name="QuestView" ItemsSource="{Binding Quests}" ItemsUpdatingScrollMode="KeepLastItemInView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <local:NewContent1/>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No quests yet."
                           FontSize="16" TextColor="Gray"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>

            </CollectionView>
        </Border>
        
        <Entry Grid.Row="3"
               x:Name="QuestName"
               Text=""
               Placeholder="Quest Name"
               FontSize="18" />
        <Entry Grid.Row="4"
               x:Name="QuestGiver"
               Text=""
               Placeholder="Quest Giver"
               FontSize="18" />
        <Entry Grid.Row="5"
               x:Name="QuestReward"
               Text=""
               Placeholder="Quest Reward"
               FontSize="18" />
        <Button Grid.Row="6"
                Text="Accept a quest"
                Clicked="OnAddClicked" />
        <Button Grid.Row="7"
                x:Name="FinishButton"
                Text="Finished Quest"
                Clicked="OnDeleteClicked" />

    </Grid>
</ContentPage>
